---
import BaseLayout from '../layouts/BaseLayout.astro';
import Doodle from '../components/Doodle.astro';
---

<BaseLayout title="Page not found" noindex>
  <section class="lost">
    <span class="lost__doodle tint-blue" aria-hidden="true"><Doodle name="plane" filled draw /></span>
    <h1><span class="marker tint-yellow">Oops!</span></h1>
    <p>This page flew away. Maybe it was a paper airplane?</p>
    <p><a class="button tint-green" href="/">Take me home</a></p>
  </section>
</BaseLayout>

<style>
  .lost {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    padding-block: 4rem;
    text-align: center;
  }

  .lost__doodle {
    width: 9rem;
    height: 9rem;
    color: var(--ink);
    animation: fly 3s ease-in-out infinite;
  }

  .lost__doodle :global(svg) {
    width: 100%;
    height: 100%;
  }

  h1 {
    font-size: clamp(3rem, 12vw, 5rem);
  }

  p {
    margin: 0.5rem 0;
    font-size: 1.2em;
  }

  @keyframes fly {
    50% {
      translate: 12px -10px;
      rotate: -6deg;
    }
  }
</style>
