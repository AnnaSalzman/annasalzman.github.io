---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getResources } from '../../lib/content.ts';

export const getStaticPaths = (async () => {
  const resources = await getResources();
  return resources.map((resource) => ({ params: { id: resource.id }, props: { resource } }));
}) satisfies GetStaticPaths;

const { resource } = Astro.props;
const { title, description, emoji, color, draft } = resource.data;
const { Content } = await render(resource);
---

<BaseLayout title={title} description={description} section="resources">
  <div class:list={['resource', color && `tint-${color}`]}>
    <PageHeader title={title} intro={description} emoji={emoji ?? '📚'}>
      {draft && <span class="draft-badge">Draft: only you can see this</span>}
    </PageHeader>
    <div class="prose">
      <Content />
    </div>
    <p class="back"><a class="more-link" href="/resources/">← All resources</a></p>
  </div>
</BaseLayout>

<style>
  .back {
    margin-top: 3.5rem;
  }
</style>
