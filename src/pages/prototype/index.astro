---
/**
 * PROTOTYPE of the illustrated home page, built from Anna's sketch.
 * Not linked from anywhere and kept out of search engines. When it's
 * adopted, this becomes src/pages/index.astro.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Scene from '../../components/scene/Scene.astro';
---

<BaseLayout title="Bonjour !" noindex showNav={false}>
  <header class="intro">
    <h1><span class="marker tint-yellow">Bonjour&nbsp;!</span></h1>
    <p>Welcome to Madame Salzman’s corner of the internet. Every drawing is a door: click around.</p>
  </header>
  <Scene />
</BaseLayout>

<style>
  .intro {
    margin-block: 1.5rem 1rem;
    text-align: center;
  }

  h1 {
    font-size: clamp(2.6rem, 8vw, 4.2rem);
  }

  .intro p {
    max-width: 34rem;
    margin: 0.6rem auto 0;
    color: var(--ink-soft);
  }
</style>
