---
/** PROTOTYPE stand-in for the future films section (the cinema in the home scene). */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CinemaScreen from '../../assets/scene/cinema-screen.svg';
---

<BaseLayout title="Au cinéma" noindex>
  <div class="tint-orange">
    <PageHeader title="Au cinéma" intro="French film picks and reviews. Coming soon: grab a ticket and check back!" />
    <CinemaScreen class="screen" aria-hidden="true" />
    <p><a class="more-link" href="/prototype/">← Back to the town</a></p>
  </div>
</BaseLayout>

<style>
  .screen {
    width: min(100%, 26rem);
    height: auto;
    margin-block: 1rem 2rem;
    color: var(--ink);
  }
</style>
