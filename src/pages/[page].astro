---
/** Standalone pages from src/content/pages/ (About, …), each at /<file name>/. */
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getPages } from '../lib/content.ts';
import { NAV } from '../site.ts';

export const getStaticPaths = (async () => {
  const pages = await getPages();
  return pages.map((page) => ({ params: { page: page.id }, props: { page } }));
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const { title, description, hidden, draft } = page.data;
const { Content } = await render(page);
const nav = NAV.find((item) => item.href === `/${page.id}/`);
---

<BaseLayout title={title} description={description} section={nav?.section} noindex={hidden}>
  <PageHeader title={title} intro={description} emoji={nav?.emoji}>
    {draft && <span class="draft-badge">Draft: only you can see this</span>}
  </PageHeader>
  <div class="prose">
    <Content />
  </div>
</BaseLayout>
