---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import PrevNext from '../../components/PrevNext.astro';
import TagList from '../../components/TagList.astro';
import { getPosts, neighbours } from '../../lib/content.ts';
import { frenchSpacing } from '../../lib/typography.ts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post, ...neighbours(posts, post.id) },
  }));
}) satisfies GetStaticPaths;

const { post, newer, older } = Astro.props;
const { title, date, description, cover, coverAlt, tags, draft } = post.data;
const { Content } = await render(post);
---

<BaseLayout title={title} description={description} image={cover} section="blog" type="article">
  <article class="post">
    <header class="post__header">
      <p class="post__date">
        <FormattedDate date={date} />
        {draft && <span class="draft-badge">Draft: only you can see this</span>}
      </p>
      <h1>{frenchSpacing(title)}</h1>
      <TagList tags={tags} />
    </header>

    {
      cover && (
        <Image
          class="post__cover"
          src={cover}
          alt={coverAlt ?? ''}
          width={1400}
          widths={[640, 960, 1400]}
          sizes="(min-width: 56rem) 52rem, 100vw"
          loading="eager"
        />
      )
    }

    <div class="prose">
      <Content />
    </div>
  </article>

  <PrevNext base="/blog/" allLabel="All posts" newer={newer} older={older} />
</BaseLayout>

<style>
  .post {
    max-width: 52rem;
    margin-inline: auto;
  }

  .post__header {
    display: grid;
    gap: 0.9rem;
    margin-block: 2.5rem 2rem;
  }

  .post__date {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
    margin: 0;
    font-weight: 600;
    color: var(--ink-soft);
  }

  .post__date :global(time) {
    padding: 0.15rem 0.7rem;
    border: 2px dashed var(--tint-strong);
    border-radius: 8px;
    color: var(--tint-strong);
    rotate: -2deg;
  }

  h1 {
    font-size: clamp(2.2rem, 6vw, 3.4rem);
  }

  .post__cover {
    width: 100%;
    margin-bottom: 2.25rem;
    border: var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .prose {
    margin-inline: auto;
  }
</style>
