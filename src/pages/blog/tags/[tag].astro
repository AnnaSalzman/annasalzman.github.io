---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import PostCard from '../../../components/PostCard.astro';
import { getPosts, getTags, tagSlug } from '../../../lib/content.ts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  const tags = await getTags();
  return tags.map((tag) => ({
    params: { tag: tag.slug },
    props: { tag, posts: posts.filter((post) => post.data.tags.some((name) => tagSlug(name) === tag.slug)) },
  }));
}) satisfies GetStaticPaths;

const { tag, posts } = Astro.props;
const count = posts.length === 1 ? '1 post' : `${posts.length} posts`;
---

<BaseLayout title={`#${tag.name}`} description={`Blog posts tagged “${tag.name}”.`} section="blog">
  <PageHeader title={`#${tag.name}`} intro={`${count} tagged “${tag.name}”.`}>
    <p><a class="more-link" href="/blog/">← All posts</a></p>
  </PageHeader>

  <div class="post-grid">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</BaseLayout>
