---
/**
 * PROTOTYPE: layout for a place in the "French town" (museum, cinema, …):
 * the town menu, then the place's own drawing with its French name.
 */
import BaseLayout from './BaseLayout.astro';
import PlaceArt from '../components/scene/PlaceArt.astro';
import TownNav from '../components/scene/TownNav.astro';
import { placeById, type PartName, type PlaceId } from '../components/scene/town.ts';
import { frenchSpacing } from '../lib/typography.ts';

interface Props {
  place: PlaceId;
  /** Defaults to the place's French name. */
  title?: string;
  subtitle?: string;
  /** Browser-tab title, if it should differ from the heading. */
  pageTitle?: string;
  description?: string;
  /** Drawings in the header; defaults to the place's own. */
  art?: PartName[];
}

const { place: placeId, title, subtitle, pageTitle, description, art } = Astro.props;
const place = placeById(placeId);
const heading = title ?? place.title;
const parts = art ?? place.header;
---

<BaseLayout title={pageTitle ?? heading} description={description ?? subtitle} noindex showNav={false}>
  <TownNav current={placeId} />

  <header class:list={['town-header', `tint-${place.color}`, `town-header--${placeId}`]}>
    <svg class="town-header__defs" width="0" height="0" aria-hidden="true">
      <filter id="town-wash" x="-20%" y="-20%" width="140%" height="140%">
        <feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="2" seed="5" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="20" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </svg>
    <div class="town-header__art">
      <PlaceArt parts={parts} />
    </div>
    <div class="town-header__text">
      <h1 lang="fr"><span class="marker">{frenchSpacing(heading)}</span></h1>
      {subtitle && <p>{frenchSpacing(subtitle)}</p>}
      <slot name="header" />
    </div>
  </header>

  <slot />
</BaseLayout>

<style>
  .town-header {
    display: grid;
    gap: 1.5rem 3rem;
    align-items: center;
    margin-block: 2.5rem 3rem;
  }

  @media (min-width: 48rem) {
    .town-header {
      grid-template-columns: minmax(0, var(--art-width, 18rem)) 1fr;
    }
  }

  .town-header__defs {
    position: absolute;
  }

  .town-header__art {
    position: relative;
    isolation: isolate;
    width: min(100%, var(--art-width, 18rem));
    color: var(--ink);
  }

  /* the same watercolor wash as on the town's home page */
  .town-header__art::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: var(--wash, 12% 6% 6% 14%);
    background: var(--tint-soft);
    border-radius: 46% 54% 58% 42% / 52% 44% 56% 48%;
    rotate: -4deg;
    filter: url(#town-wash);
  }

  .town-header--photos {
    --art-width: 14rem;
    --wash: 34% 30% -2% 4%;
  }
  .town-header--pedagogy {
    --art-width: 18rem;
  }
  .town-header--museum {
    --art-width: 26rem;
    --wash: 4% 6% 40% 30%;
  }
  .town-header--cinema {
    --art-width: 20rem;
    --wash: -4% -4% 30% 10%;
  }
  .town-header--memory {
    --art-width: 11rem;
    --wash: 50% -10% 0% 44%;
  }

  h1 {
    font-size: clamp(2.6rem, 7vw, 4rem);
  }

  .town-header__text p {
    max-width: 34rem;
    margin: 0.75rem 0 0;
    font-size: 1.15em;
    color: var(--ink-soft);
  }
</style>
