---
/** The page for one drawing or one photo: the picture, big, with its words underneath. */
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';
import PrevNext from './PrevNext.astro';

type Item = CollectionEntry<'drawings'> | CollectionEntry<'photos'>;

interface Props {
  item: Item;
  newer?: Item;
  older?: Item;
  base: string;
  allLabel: string;
  look: 'taped' | 'polaroid';
}

const { item, newer, older, base, allLabel, look } = Astro.props;
const { title, date, image, alt, draft } = item.data;
const { Content } = await render(item);
---

<article class:list={['detail', `detail--${look}`]}>
  <figure class="detail__frame">
    <Image
      src={image}
      alt={alt ?? title}
      width={1800}
      widths={[640, 960, 1280, 1800]}
      sizes="(min-width: 60rem) 56rem, 100vw"
      loading="eager"
    />
  </figure>

  <div class="detail__words">
    <h1>{title}</h1>
    <p class="detail__date">
      <FormattedDate date={date} />
      {draft && <span class="draft-badge">Draft: only you can see this</span>}
    </p>
    <div class="prose">
      <Content />
    </div>
  </div>
</article>

<PrevNext base={base} allLabel={allLabel} newer={newer} older={older} />

<style>
  .detail {
    max-width: 56rem;
    margin: 3rem auto 0;
  }

  .detail__frame {
    position: relative;
    margin: 0;
    padding: 0.8rem;
    background: var(--surface);
    border: var(--border);
    box-shadow: var(--shadow-lg);
    rotate: -0.6deg;
  }

  .detail__frame img {
    width: 100%;
    max-height: 80vh;
    object-fit: contain;
  }

  .detail--taped .detail__frame::before,
  .detail--taped .detail__frame::after {
    content: '';
    position: absolute;
    top: -0.9rem;
    width: 6.5rem;
    height: 1.7rem;
    background: color-mix(in srgb, var(--tint) 72%, transparent);
    border-inline: 2px dashed color-mix(in srgb, var(--line) 25%, transparent);
  }

  .detail--taped .detail__frame::before {
    left: -1.2rem;
    rotate: -35deg;
    top: 0.4rem;
  }

  .detail--taped .detail__frame::after {
    right: -1.2rem;
    rotate: 35deg;
    top: 0.4rem;
  }

  .detail--polaroid .detail__frame {
    padding: 0.9rem 0.9rem 3.5rem;
  }

  .detail--polaroid .detail__frame img {
    border: 2px solid var(--line);
  }

  .detail__words {
    max-width: var(--text-width);
    margin: 2.25rem auto 0;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 2.8rem);
  }

  .detail__date {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
    margin: 0.4rem 0 1.25rem;
    font-weight: 600;
    color: var(--ink-soft);
  }
</style>
