---
import type { CollectionEntry } from 'astro:content';
import { colorFor } from '../lib/colors.ts';
import { frenchSpacing } from '../lib/typography.ts';

interface Props {
  resource: CollectionEntry<'resources'>;
}

const { resource } = Astro.props;
const { title, description, emoji, color, draft } = resource.data;
---

<a class:list={['resource-card', 'sticker', `tint-${color ?? colorFor(resource.id)}`]} href={`/resources/${resource.id}/`}>
  <span class="resource-card__emoji" aria-hidden="true">{emoji ?? '📚'}</span>
  <span class="resource-card__text">
    <span class="resource-card__title">
      {frenchSpacing(title)}
      {draft && <span class="draft-badge">Draft</span>}
    </span>
    {description && <span class="resource-card__description">{frenchSpacing(description)}</span>}
  </span>
</a>

<style>
  .resource-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 100%;
    padding: 1.1rem 1.25rem;
    text-decoration: none;
    background: var(--tint-soft);
    transition:
      transform 0.25s var(--ease-bounce),
      box-shadow 0.25s var(--ease-bounce);
  }

  .resource-card:hover {
    transform: rotate(-1deg) translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .resource-card__emoji {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 4rem;
    height: 4rem;
    font-size: 2.2rem;
    background: var(--tint);
    border: var(--border);
    border-radius: 50%;
    rotate: -6deg;
    transition: rotate 0.4s var(--ease-bounce);
  }

  .resource-card:hover .resource-card__emoji {
    rotate: 8deg;
  }

  .resource-card__text {
    display: grid;
    gap: 0.2rem;
  }

  .resource-card__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.3rem;
    line-height: 1.2;
  }

  .resource-card__description {
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.45;
  }

  @media (prefers-reduced-motion: reduce) {
    .resource-card:hover {
      transform: none;
    }
  }
</style>
