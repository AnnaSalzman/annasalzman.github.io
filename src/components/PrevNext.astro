---
/** "← Newer / All … / Older →" links at the bottom of a post, drawing or photo. */
interface Link {
  id: string;
  data: { title: string };
}

interface Props {
  base: string;
  allLabel: string;
  newer?: Link;
  older?: Link;
}

const { base, allLabel, newer, older } = Astro.props;
---

<nav class="prev-next" aria-label="More">
  <div class="prev-next__side">
    {
      newer && (
        <a href={`${base}${newer.id}/`} rel="prev">
          <span class="prev-next__hint">← Newer</span>
          <span class="prev-next__title">{newer.data.title}</span>
        </a>
      )
    }
  </div>
  <a class="button button--quiet prev-next__all" href={base}>{allLabel}</a>
  <div class="prev-next__side prev-next__side--end">
    {
      older && (
        <a href={`${base}${older.id}/`} rel="next">
          <span class="prev-next__hint">Older →</span>
          <span class="prev-next__title">{older.data.title}</span>
        </a>
      )
    }
  </div>
</nav>

<style>
  .prev-next {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    align-items: center;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 3px dashed color-mix(in srgb, var(--line) 30%, transparent);
  }

  @media (min-width: 44rem) {
    .prev-next {
      grid-template-columns: 1fr auto 1fr;
    }
  }

  .prev-next__all {
    justify-self: center;
    order: 3;
  }

  @media (min-width: 44rem) {
    .prev-next__all {
      order: 0;
    }
  }

  .prev-next__side--end {
    text-align: right;
  }

  .prev-next__side a {
    display: inline-grid;
    gap: 0.1rem;
    text-decoration: none;
  }

  .prev-next__hint {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink-soft);
  }

  .prev-next__title {
    font-family: var(--font-display);
    font-weight: 700;
    text-decoration-line: underline;
    text-decoration-color: var(--tint);
    text-decoration-thickness: 0.15em;
    text-underline-offset: 0.2em;
  }

  .prev-next__side a:hover .prev-next__title {
    text-decoration-style: wavy;
  }
</style>
