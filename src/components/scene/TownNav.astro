---
/**
 * PROTOTYPE: the town menu. Tiny versions of Anna's drawings instead of the
 * emoji pills, with short French labels (English names for screen readers).
 */
import PlaceArt from './PlaceArt.astro';
import { PLACES, TOWN_HOME, type PlaceId } from './town.ts';

interface Props {
  current?: PlaceId;
}

const { current } = Astro.props;
---

<nav class="town-nav" aria-label="Town">
  <a class="town-nav__home" href={TOWN_HOME}><span aria-hidden="true">←</span> <span lang="fr">La ville</span></a>
  <ul>
    {
      PLACES.map((place) => (
        <li>
          <a
            class:list={['town-nav__link', `tint-${place.color}`]}
            href={place.href}
            aria-current={place.id === current ? 'page' : undefined}
            aria-label={place.name}
          >
            <span class="town-nav__icon">
              <PlaceArt parts={place.icon} height="2.6rem" />
            </span>
            <span class="town-nav__label" lang="fr">
              {place.short}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .town-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 0.5rem;
    padding-bottom: 1rem;
    border-bottom: 3px dotted color-mix(in srgb, var(--ink) 30%, transparent);
  }

  .town-nav__home {
    font-family: var(--font-display);
    font-weight: 700;
    text-decoration: none;
  }

  .town-nav__home:hover {
    text-decoration: underline wavy var(--color-purple);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .town-nav__link {
    display: grid;
    justify-items: center;
    gap: 0.2rem;
    min-width: 4.25rem;
    padding: 0.35rem 0.5rem 0.25rem;
    color: var(--ink);
    text-decoration: none;
    border-radius: 14px;
    transition:
      background-color 0.2s,
      transform 0.25s var(--ease-bounce);
  }

  .town-nav__icon {
    --art-h: 2.6rem;
    display: grid;
    place-items: center;
    height: var(--art-h);
  }

  .town-nav__label {
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.1;
  }

  .town-nav__link:hover {
    background: var(--tint-soft);
    transform: translateY(-2px) rotate(-2deg);
  }

  .town-nav__link[aria-current='page'] {
    background: var(--tint-soft);
  }

  .town-nav__link[aria-current='page'] .town-nav__label {
    text-decoration: underline;
    text-decoration-color: var(--tint);
    text-decoration-thickness: 0.2em;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 40rem) {
    .town-nav {
      justify-content: center;
    }

    ul {
      flex-wrap: nowrap;
      justify-content: center;
      gap: 0;
    }

    .town-nav__link {
      min-width: 0;
      padding-inline: 0.3rem;
    }

    .town-nav__icon {
      --art-h: 1.75rem;
    }

    .town-nav__label {
      font-size: 0.72rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .town-nav__link:hover {
      transform: none;
    }
  }
</style>
