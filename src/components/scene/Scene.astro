---
/**
 * PROTOTYPE: the home page as Anna's illustrated town (from her sketch, docs/
 * DECISIONS.md). Each drawing is a door to a section, with a small ritual:
 * the camera flashes, the marker writes A B C, a visitor climbs the museum
 * stairs, a ticket slides out of the box office, the madeleine gets eaten.
 *
 * Drawings are SVGs extracted from her sketch (src/assets/scene/), placed at
 * their sketch coordinates on desktop and stacked as a walk on phones.
 * Ink is `currentColor`, so it turns to chalk in the chalkboard theme.
 */
import { getImage } from 'astro:assets';
import type { Color } from '../../lib/colors.ts';
import { getPhotos } from '../../lib/content.ts';

import BoardLabel from '../../assets/scene/board-label.svg';
import BoardLetters from '../../assets/scene/board-letters.svg';
import Board from '../../assets/scene/board.svg';
import CinemaBooth from '../../assets/scene/cinema-booth.svg';
import CinemaLabel from '../../assets/scene/cinema-label.svg';
import CinemaScreen from '../../assets/scene/cinema-screen.svg';
import CinemaSeats from '../../assets/scene/cinema-seats.svg';
import MadeleineLabel from '../../assets/scene/madeleine-label.svg';
import Madeleine from '../../assets/scene/madeleine.svg';
import MuseumFigure from '../../assets/scene/museum-figure.svg';
import MuseumLabel from '../../assets/scene/museum-label.svg';
import Museum from '../../assets/scene/museum.svg';
import PortraitLabel from '../../assets/scene/portrait-label.svg';
import Portrait from '../../assets/scene/portrait.svg';
import Profile from '../../assets/scene/profile.svg';

type Box = [x: number, y: number, w: number, h: number];

/** Where each drawing sits on Anna's sketch page (sketch units, page is 685 × 514). */
const PARTS = {
  portrait: { svg: Portrait, box: [63.85, 37.51, 115.32, 123.33] },
  'portrait-label': { svg: PortraitLabel, box: [163.64, 43.3, 112.43, 92.68] },
  board: { svg: Board, box: [30.74, 197.37, 113.82, 62.95] },
  'board-letters': { svg: BoardLetters, box: [48.5, 205.3, 57.75, 38.29] },
  'board-label': { svg: BoardLabel, box: [12.66, 258.31, 149.46, 113.93] },
  museum: { svg: Museum, box: [324.77, 86.36, 314.19, 210.44] },
  'museum-figure': { svg: MuseumFigure, box: [430.71, 291.57, 29.64, 61.04] },
  'museum-label': { svg: MuseumLabel, box: [387.18, 352.79, 154.05, 93.71] },
  'cinema-screen': { svg: CinemaScreen, box: [206.42, 310.84, 144.82, 88.8] },
  'cinema-seats': { svg: CinemaSeats, box: [224.54, 406.08, 121.19, 22.66] },
  'cinema-booth': { svg: CinemaBooth, box: [245.16, 434.3, 82.45, 80.08] },
  'cinema-label': { svg: CinemaLabel, box: [326.99, 456.19, 125.75, 46.45] },
  profile: { svg: Profile, box: [21.86, 395.93, 65.49, 112.75] },
  madeleine: { svg: Madeleine, box: [95.13, 459.56, 22.98, 34.0] },
  'madeleine-label': { svg: MadeleineLabel, box: [86.64, 405.84, 111.32, 58.74] },
} satisfies Record<string, { svg: unknown; box: Box }>;

type PartName = keyof typeof PARTS;

interface Place {
  id: string;
  href: string;
  name: string;
  hint: string;
  color: Color;
  art: PartName[];
  label: PartName;
  /** Width of the drawing when stacked on a phone, as a share of the column. */
  mobileWidth: number;
}

const places: Place[] = [
  { id: 'photos', href: '/photos/', name: 'Photos', hint: 'Madame Salzman’s photos', color: 'blue', art: ['portrait'], label: 'portrait-label', mobileWidth: 0.62 },
  { id: 'pedagogy', href: '/blog/', name: 'Pedagogy', hint: 'Notes on teaching languages', color: 'red', art: ['board', 'board-letters'], label: 'board-label', mobileWidth: 0.8 },
  { id: 'museum', href: '/drawings/', name: 'The museum', hint: 'Drawings and francophone images', color: 'purple', art: ['museum', 'museum-figure'], label: 'museum-label', mobileWidth: 1 },
  { id: 'cinema', href: '/prototype/films/', name: 'The cinema', hint: 'French film picks and reviews', color: 'orange', art: ['cinema-screen', 'cinema-seats', 'cinema-booth'], label: 'cinema-label', mobileWidth: 0.72 },
  { id: 'memory', href: '/resources/', name: 'The memory classroom', hint: 'Games, vocab and quizzes', color: 'green', art: ['profile', 'madeleine'], label: 'madeleine-label', mobileWidth: 0.42 },
];

/** The part of the sketch page the scene shows. */
const VIEW: Box = [5, 28, 645, 492];

const pct = (n: number) => `${+(n * 100).toFixed(3)}%`;

function union(names: PartName[]): Box {
  const boxes = names.map((n) => PARTS[n].box);
  const x0 = Math.min(...boxes.map((b) => b[0]));
  const y0 = Math.min(...boxes.map((b) => b[1]));
  const x1 = Math.max(...boxes.map((b) => b[0] + b[2]));
  const y1 = Math.max(...boxes.map((b) => b[1] + b[3]));
  return [x0, y0, x1 - x0, y1 - y0];
}

/** Position in the scene (desktop). */
function inScene([x, y, w, h]: Box) {
  return `--left:${pct((x - VIEW[0]) / VIEW[2])};--top:${pct((y - VIEW[1]) / VIEW[3])};--width:${pct(w / VIEW[2])};--ratio:${w}/${h};`;
}

/** Position inside its place's drawing box (both layouts). */
function inArt([x, y, w]: Box, [ax, ay, aw, ah]: Box) {
  return `--px:${pct((x - ax) / aw)};--py:${pct((y - ay) / ah)};--pw:${pct(w / aw)};`;
}

// The two newest photos pop out of the camera.
const snapshots = await Promise.all(
  (await getPhotos()).slice(0, 2).map(async (photo) => ({
    alt: photo.data.alt ?? photo.data.title,
    image: await getImage({ src: photo.data.image, width: 220, height: 220, fit: 'cover', format: 'webp' }),
  })),
);
---

<div class="scene" style={`--view-ratio:${VIEW[2]}/${VIEW[3]};`}>
  <!-- Gives the color washes a wobbly, watercolor edge (plain shapes where unsupported). -->
  <svg class="scene__defs" width="0" height="0" aria-hidden="true">
    <filter id="scene-wash" x="-20%" y="-20%" width="140%" height="140%">
      <feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="2" seed="11" result="noise" />
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="22" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </svg>
  {
    places.map((place) => {
      const artBox = union(place.art);
      const Label = PARTS[place.label].svg;
      return (
        <a class:list={['place', `place--${place.id}`, `tint-${place.color}`]} href={place.href}>
          <span class="place__art" style={`${inScene(artBox)}--mobile-width:${pct(place.mobileWidth)};`}>
            {place.art.map((name) => {
              const Part = PARTS[name].svg;
              return (
                <span class:list={['part', `part--${name}`]} style={inArt(PARTS[name].box, artBox)}>
                  <Part aria-hidden="true" />
                </span>
              );
            })}

            {place.id === 'photos' && (
              <>
                <span class="flash" aria-hidden="true" />
                {snapshots.map((shot, i) => (
                  <span class:list={['snapshot', `snapshot--${i + 1}`]} aria-hidden="true">
                    <img src={shot.image.src} alt="" width="110" height="110" loading="lazy" decoding="async" />
                  </span>
                ))}
              </>
            )}

            {place.id === 'cinema' && (
              <>
                <span class="screen-glow" aria-hidden="true" />
                <svg class="ticket" viewBox="0 0 120 56" aria-hidden="true">
                  <path d="M6 4h108v14a10 10 0 0 0 0 20v14H6V38a10 10 0 0 0 0-20Z" />
                  <path class="ticket__perforation" d="M84 8v40" />
                  <text x="44" y="35" text-anchor="middle">BILLET</text>
                  <text class="ticket__star" x="100" y="34" text-anchor="middle">★</text>
                </svg>
              </>
            )}

            {place.id === 'memory' && (
              <span class="crumbs" aria-hidden="true">
                <i /><i /><i /><i /><i /><i />
              </span>
            )}

            <span class="place__chip" aria-hidden="true">{place.name} →</span>
          </span>

          <span class="place__label" style={inScene(PARTS[place.label].box)}>
            <Label class="place__handwriting" aria-hidden="true" />
            <span class="place__name">{place.name}</span>
            <span class="place__hint">{place.hint}</span>
          </span>
        </a>
      );
    })
  }
</div>

<script>
  const scene = document.querySelector<HTMLElement>('.scene');
  if (scene) {
    // Hidden-then-revealed states (blank whiteboard, …) only apply once this runs.
    scene.classList.add('is-ready');
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

    // Touch screens can't hover: play each place's little animation when it scrolls into view.
    if (matchMedia('(hover: none)').matches && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.closest('.place')?.classList.add('is-active');
            observer.unobserve(entry.target);
          }
        },
        { threshold: 0.6 },
      );
      for (const art of scene.querySelectorAll('.place__art')) observer.observe(art);
    }

    // "Eat the madeleine to enter the memory classroom": three bites, then go.
    const memory = scene.querySelector<HTMLAnchorElement>('.place--memory');
    memory?.addEventListener('click', (event) => {
      if (reduceMotion.matches || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey) return;
      event.preventDefault();
      memory.classList.add('is-eating');
      setTimeout(() => {
        location.href = memory.href;
      }, 1000);
    });
  }
</script>

<style>
  .scene {
    position: relative;
    width: min(100%, 68rem);
    margin-inline: auto;
    aspect-ratio: var(--view-ratio);
    color: var(--ink);
  }

  /* The link itself has no box on desktop; its drawing and label are placed in the scene. */
  .place {
    color: inherit;
    text-decoration: none;
    outline: none;
  }

  .place__art,
  .place__label {
    position: absolute;
    left: var(--left);
    top: var(--top);
    width: var(--width);
  }

  .place__art {
    aspect-ratio: var(--ratio);
    isolation: isolate;
    cursor: pointer;
  }

  .part {
    position: absolute;
    left: var(--px);
    top: var(--py);
    width: var(--pw);
  }

  .part :global(svg),
  .place__label :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .scene__defs {
    position: absolute;
  }

  /* A wash of color behind part of each drawing, off-register like a risograph print. */
  .place__art::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: var(--wash, 10% 10% 10% 10%);
    background: var(--tint-soft);
    border-radius: 46% 54% 58% 42% / 52% 44% 56% 48%;
    rotate: -4deg;
    filter: url(#scene-wash);
    transition:
      background-color 0.3s,
      scale 0.4s var(--ease-bounce);
  }

  .place--photos .place__art {
    --wash: 34% 38% -2% 4%;
  }
  .place--pedagogy .place__art {
    --wash: 6% -3% -8% 12%;
  }
  .place--museum .place__art {
    --wash: 4% 6% 50% 30%;
  }
  .place--cinema .place__art {
    --wash: -3% -4% 55% 10%;
  }
  .place--memory .place__art {
    --wash: 52% -8% 0% 46%;
  }

  .place:is(:hover, :focus-visible, .is-active) .place__art::before {
    background: color-mix(in srgb, var(--tint) 35%, var(--tint-soft));
    scale: 1.04;
  }

  .place__label {
    cursor: pointer;
  }

  /* The typed name is what screen readers announce; on desktop it shows as a chip on hover. */
  .place__name,
  .place__hint {
    position: absolute !important;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .place__chip {
    position: absolute;
    z-index: 5;
    left: 50%;
    top: 0;
    translate: -50% calc(-100% - 0.4rem);
    padding: 0.15rem 0.75rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    white-space: nowrap;
    color: var(--on-tint);
    background: var(--tint);
    border: 2px solid var(--line);
    border-radius: 999px;
    opacity: 0;
    scale: 0.8;
    pointer-events: none;
    transition:
      opacity 0.2s,
      scale 0.3s var(--ease-bounce);
  }

  .place:is(:hover, :focus-visible) .place__chip {
    opacity: 1;
    scale: 1;
  }

  .place:focus-visible .place__art,
  .place:focus-visible .place__label {
    outline: 3px solid var(--color-blue-strong);
    outline-offset: 6px;
    border-radius: 10px;
  }

  /* ---------- Photos: the camera flashes and two photos pop out ---------- */

  .flash {
    position: absolute;
    left: 62%;
    top: 45%;
    width: 14%;
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(circle, #fff 0 25%, var(--color-yellow) 45%, transparent 70%);
    opacity: 0;
    pointer-events: none;
  }

  .place--photos:is(:hover, :focus-visible, .is-active) .flash {
    animation: flash 0.6s ease-out;
  }

  @keyframes flash {
    0% {
      opacity: 0;
      scale: 0.3;
    }
    20% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      scale: 5;
    }
  }

  .snapshot {
    position: absolute;
    z-index: 4;
    left: 70%;
    top: 46%;
    width: 32%;
    padding: 5% 5% 14%;
    background: #fff;
    border: 2px solid var(--line);
    box-shadow: var(--shadow);
    opacity: 0;
    scale: 0.2;
    translate: -50% -50%;
    pointer-events: none;
    transition:
      opacity 0.2s,
      scale 0.45s var(--ease-bounce),
      translate 0.45s var(--ease-bounce),
      rotate 0.45s var(--ease-bounce);
  }

  .snapshot img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .place--photos:is(:hover, :focus-visible, .is-active) .snapshot {
    opacity: 1;
    scale: 1;
  }

  .place--photos:is(:hover, :focus-visible, .is-active) .snapshot--1 {
    translate: -35% -150%;
    rotate: -8deg;
    transition-delay: 0.15s;
  }

  .place--photos:is(:hover, :focus-visible, .is-active) .snapshot--2 {
    translate: 45% -135%;
    rotate: 7deg;
    transition-delay: 0.3s;
  }

  /* ---------- Pedagogy: the marker writes A B C on the board ---------- */

  .scene.is-ready .part--board-letters {
    clip-path: inset(0 100% 0 0);
  }

  .scene.is-ready .place--pedagogy:is(:hover, :focus-visible, .is-active) .part--board-letters {
    animation: write 1.3s steps(14, end) forwards;
  }

  @keyframes write {
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  /* ---------- Museum: a visitor climbs the stairs ---------- */

  .place--museum:is(:hover, :focus-visible, .is-active) .part--museum-figure {
    animation: climb 1.8s ease-in-out forwards;
  }

  @keyframes climb {
    0% {
      translate: 0 0;
      scale: 1;
    }
    20% {
      translate: 25% -30%;
    }
    40% {
      translate: 55% -75%;
      scale: 0.9;
    }
    60% {
      translate: 90% -120%;
      scale: 0.8;
    }
    80% {
      translate: 125% -165%;
      scale: 0.7;
      opacity: 1;
    }
    100% {
      translate: 150% -200%;
      scale: 0.6;
      opacity: 0;
    }
  }

  /* ---------- Cinema: the screen lights up and a ticket slides out ---------- */

  .screen-glow {
    position: absolute;
    z-index: -1;
    left: 3%;
    top: 3%;
    width: 94%;
    height: 37%;
    border-radius: 6px;
    background: radial-gradient(ellipse at 50% 60%, var(--color-yellow-soft), transparent 75%);
    opacity: 0;
  }

  .place--cinema:is(:hover, :focus-visible, .is-active) .screen-glow {
    animation: projector 1.2s ease-out forwards;
  }

  @keyframes projector {
    0% {
      opacity: 0;
    }
    30% {
      opacity: 0.9;
    }
    40% {
      opacity: 0.4;
    }
    55% {
      opacity: 1;
    }
    100% {
      opacity: 0.85;
    }
  }

  .ticket {
    position: absolute;
    z-index: 4;
    left: 55%;
    top: 76%;
    width: 42%;
    translate: -50% -50%;
    opacity: 0;
    scale: 0.4;
    pointer-events: none;
    fill: var(--tint);
    stroke: var(--line);
    stroke-width: 3;
    stroke-linejoin: round;
    overflow: visible;
    transition:
      opacity 0.2s,
      scale 0.4s var(--ease-bounce),
      translate 0.5s var(--ease-bounce),
      rotate 0.5s var(--ease-bounce);
  }

  .ticket__perforation {
    fill: none;
    stroke-dasharray: 4 5;
    stroke-width: 2;
  }

  .ticket text {
    fill: var(--on-tint);
    stroke: none;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 17px;
    letter-spacing: 0.06em;
  }

  .place--cinema:is(:hover, :focus-visible, .is-active) .ticket {
    opacity: 1;
    scale: 1;
    translate: -105% -35%;
    rotate: -9deg;
    transition-delay: 0.2s;
  }

  /* ---------- Memory classroom: eat the madeleine ---------- */

  .part--madeleine {
    transform-origin: 50% 80%;
  }

  .place--memory:is(:hover, :focus-visible) .part--madeleine {
    animation: wobble 0.7s ease-in-out;
  }

  @keyframes wobble {
    25% {
      rotate: -10deg;
    }
    75% {
      rotate: 8deg;
    }
  }

  .place--memory.is-eating .part--madeleine {
    animation: bites 0.9s steps(1, end) forwards;
  }

  /* Each step cuts another round bite out of the top. */
  @keyframes bites {
    0% {
      -webkit-mask-image: radial-gradient(circle at 100% 0, transparent 24%, #000 25%);
      mask-image: radial-gradient(circle at 100% 0, transparent 24%, #000 25%);
    }
    33% {
      -webkit-mask-image: radial-gradient(circle at 100% 0, transparent 38%, #000 39%);
      mask-image: radial-gradient(circle at 100% 0, transparent 38%, #000 39%);
    }
    66% {
      -webkit-mask-image: radial-gradient(circle at 70% -8%, transparent 50%, #000 51%);
      mask-image: radial-gradient(circle at 70% -8%, transparent 50%, #000 51%);
    }
    100% {
      -webkit-mask-image: radial-gradient(circle at 50% -12%, transparent 68%, #000 69%);
      mask-image: radial-gradient(circle at 50% -12%, transparent 68%, #000 69%);
    }
  }

  .crumbs {
    position: absolute;
    left: 85%;
    top: 62%;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .crumbs i {
    position: absolute;
    width: 5px;
    height: 4px;
    border-radius: 40%;
    background: var(--color-orange);
    opacity: 0;
  }

  .place--memory.is-eating .crumbs i {
    animation: crumb 0.8s ease-in forwards;
  }

  .crumbs i:nth-child(2) {
    --dx: 14px;
    animation-delay: 0.1s !important;
  }
  .crumbs i:nth-child(3) {
    --dx: -10px;
    animation-delay: 0.3s !important;
  }
  .crumbs i:nth-child(4) {
    --dx: 22px;
    animation-delay: 0.35s !important;
  }
  .crumbs i:nth-child(5) {
    --dx: 4px;
    animation-delay: 0.6s !important;
  }
  .crumbs i:nth-child(6) {
    --dx: -18px;
    animation-delay: 0.65s !important;
  }

  @keyframes crumb {
    0% {
      opacity: 1;
      translate: 0 0;
    }
    100% {
      opacity: 0;
      translate: var(--dx, 8px) 46px;
      rotate: 140deg;
    }
  }

  /* ---------- Phones: the scene becomes a walk, one place after another ---------- */

  @media (max-width: 51.99rem) {
    .scene {
      display: grid;
      gap: 2.5rem;
      aspect-ratio: auto;
    }

    .place {
      position: relative;
      display: grid;
      justify-items: center;
      gap: 0.9rem;
    }

    /* the dotted footpath between places */
    .place + .place::before {
      content: '';
      position: absolute;
      top: -2.25rem;
      left: 50%;
      height: 2rem;
      border-left: 3px dotted color-mix(in srgb, var(--ink) 45%, transparent);
    }

    .place__art,
    .place__label {
      position: relative;
      left: auto;
      top: auto;
    }

    .place__art {
      width: var(--mobile-width);
      max-width: 24rem;
    }

    .place__label {
      width: min(78%, 14rem);
      text-align: center;
    }

    .place__name,
    .place__hint {
      position: static !important;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
      white-space: normal;
      display: block;
    }

    .place__name {
      margin-top: 0.6rem;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.15rem;
      text-decoration: underline;
      text-decoration-color: var(--tint);
      text-decoration-thickness: 0.18em;
      text-underline-offset: 0.2em;
    }

    .place__hint {
      font-size: 0.9rem;
      color: var(--ink-soft);
    }

    .place__chip {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scene.is-ready .part--board-letters {
      clip-path: none;
    }

    .place .part,
    .place .flash,
    .place .screen-glow {
      animation: none !important;
    }
  }
</style>
